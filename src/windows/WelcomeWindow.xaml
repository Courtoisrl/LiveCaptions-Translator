<ui:FluentWindow
    x:Class="LiveCaptionsTranslator.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="快速开始"
    Width="700"
    Height="490"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Height="27"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Header>
                <ui:TextBlock Padding="15,0,0,0" VerticalAlignment="Center">
                    快速开始
                </ui:TextBlock>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Background="{ui:ThemeResource SystemFillColorNeutralBackgroundBrush}">
            <TextBlock
                Margin="20"
                HorizontalAlignment="Left"
                FontSize="24"
                FontWeight="Bold"
                Text="欢迎使用 LiveCaptions Translator！"
                TextAlignment="Left" />
            <ui:TextBlock
                Margin="20,10,20,10"
                TextAlignment="Left"
                TextWrapping="Wrap">
                <Run Text="LiveCaptions Translator 基于 Windows 实时字幕（LiveCaptions）运行。" />
                <Run Text="首次运行前，请按以下步骤完成配置：&#x0A;" />
                <Run Text="&#x0A;1. 打开 Windows 实时字幕，按引导下载设备端语音识别所需的文件和语言包。" />
                <Run Text="&#x0A;2. 点击 Windows 实时字幕中的" />
                <Run FontWeight="Bold" Text="⚙️ 齿轮" />
                <Run Text="图标打开设置菜单，选择" />
                <Run FontWeight="Bold" Text="&quot;位置 &gt; 叠加在屏幕上&quot;" />
                <Run Text="。&#x0A;3. 点击本程序设置页中的" />
                <Run FontWeight="Bold" Text="&quot;隐藏&quot;" />
                <Run Text="按钮，将 Windows 实时字幕隐藏。&#x0A;" />
                <Run Text="&#x0A;程序已自动打开设置页并启动 Windows 实时字幕。" />
                <Run Text="完成配置后，切回主页面即可开始实时音频翻译。&#x0A;" />
                <Run Text="&#x0A;更多说明请访问 Wiki：" />
                <Hyperlink NavigateUri="https://github.com/SakiRinn/LiveCaptions-Translator/wiki" RequestNavigate="Hyperlink_RequestNavigate">
                    https://github.com/SakiRinn/LiveCaptions-Translator/wiki
                </Hyperlink>
                <Run FontWeight="Bold" Text="&#x0A;&#x0A;提示：" />
                <Run Text="如需修改" />
                <Run FontWeight="DemiBold" TextDecorations="Underline" Text="源语言" />
                <Run Text="，请在设置页点击 [显示] 打开 Windows 实时字幕后再修改。" />
            </ui:TextBlock>

            <ui:Button
                Margin="0,10,0,0"
                Padding="30,10,30,10"
                HorizontalAlignment="Center"
                Click="CloseButton_Click"
                Content="我已了解并完成配置" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>